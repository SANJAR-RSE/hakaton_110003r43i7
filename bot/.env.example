BOT_TOKEN=your-telegram-bot-token
API_URL=http://localhost:5000/api

# Leave empty for local development (uses long-polling).
# In production (Render etc.) set this to the bot service's own public
# HTTPS URL, e.g. https://medqueue-bot.onrender.com - this switches the bot
# to webhook mode, which is required on hosts that spin down an idle Web
# Service: webhook POSTs from Telegram both deliver updates and wake the
# service, whereas long-polling would silently stop once the service sleeps.
WEBHOOK_DOMAIN=
