# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/medqueue?appName=Cluster0

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Telegram bot (used by backend to push notifications, and to authenticate
# requests coming from the bot service via the /api/auth/telegram-link route)
BOT_TOKEN=your-telegram-bot-token

# AI assistant (optional). If left empty, the AI assistant still works using
# a rule-based engine backed by real database data - it just won't have
# free-form natural language generation. Add a key to upgrade it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
